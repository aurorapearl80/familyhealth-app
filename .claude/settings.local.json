{
  "permissions": {
    "allow": [
      "Bash(flutter --version)",
      "Bash(dart --version)",
      "PowerShell(flutter --version 2>&1)",
      "PowerShell(dart --version 2>&1)",
      "PowerShell(winget --version 2>&1)",
      "PowerShell(winget install Google.Flutter --silent --accept-package-agreements --accept-source-agreements 2>&1)",
      "PowerShell(winget search flutter 2>&1)",
      "PowerShell(head -20)",
      "PowerShell(flutter devices *)",
      "PowerShell(flutter run *)"
    ]
  }
}
